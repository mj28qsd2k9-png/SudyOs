# Copie para .env e preencha. O .env nao vai para o git.

# A chave da Anthropic. E o motivo de este backend existir: ela fica aqui,
# server-side, e nunca chega ao app do aluno.
ANTHROPIC_API_KEY=sk-ant-...

# Modelo de geracao. Padrao: claude-sonnet-5 (equilibrio qualidade/custo).
# Alternativas: claude-haiku-4-5 (mais barato), claude-opus-5 (mais caro).
MODELO_IA=claude-sonnet-5

# Questoes por tema. 20 e a unidade de cota do plano.
QUESTOES_POR_TEMA=20

PORT=3333
HOST=0.0.0.0
NODE_ENV=development

# Origens liberadas no CORS, separadas por virgula. Vazio libera tudo (so dev).
CORS_ORIGENS=
