{
  "name": "@estudaai/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Backend do Estuda AI: recebe o texto do material e gera aula + trilha de questoes",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/servidor.ts",
    "start": "node --env-file-if-exists=../../.env dist/servidor.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.124.0",
    "@estudaai/shared": "*",
    "@fastify/cors": "^11.2.0",
    "@fastify/static": "^10.1.3",
    "fastify": "^5.12.3",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  }
}
